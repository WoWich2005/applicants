@startuml architecture
' Архитектура компонентов системы автоматизации приёмной комиссии.
' Трёхзвенная клиент-серверная архитектура: SPA + REST API + СУБД.
' Чёрно-белое оформление по конвенции БНТУ.

skinparam DefaultFontName "Times New Roman"
skinparam DefaultFontSize 14
skinparam Monochrome true
skinparam Shadowing false
skinparam BackgroundColor #FFFFFF
skinparam ComponentBackgroundColor #FFFFFF
skinparam DatabaseBackgroundColor #FFFFFF
skinparam ActorBackgroundColor #FFFFFF
skinparam ArrowColor #000000
skinparam ArrowFontSize 12
skinparam RectangleBackgroundColor #FFFFFF
left to right direction

actor "Пользователь" as user

rectangle "Клиентское приложение\n(одностраничное\nвеб-приложение)" as spa
rectangle "Серверная часть\n(REST API)" as api
database "База данных" as db
rectangle "Управление\nмиграциями" as migrations

user -down-> spa : HTTPS
spa -right-> api
api -down-> db : SQL
migrations -down-> db : SQL
hide empty description

@enduml
